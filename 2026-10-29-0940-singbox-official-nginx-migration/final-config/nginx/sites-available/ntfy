server {
    server_name ntfy.signal-align.com;

    location / {
        proxy_pass http://127.0.0.1:2599;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    listen 127.0.0.1:14443 ssl http2 proxy_protocol;

    set_real_ip_from 127.0.0.1;

    real_ip_header proxy_protocol;
    port_in_redirect off;
    ssl_certificate /etc/letsencrypt/live/ntfy.signal-align.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ntfy.signal-align.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
server {
    if ($host = "ntfy.signal-align.com") {
        return 301 https://$host$request_uri;
    }
    listen 80;
    listen [::]:80;
    server_name ntfy.signal-align.com;
    return 404;
}
