# books-and-articles on VPS (issue #36) - web SPA + API, LE cert via DNS-01.
server {
    listen 80;
    listen [::]:80;
    server_name books-and-articles.desmondchen.com api.books-and-articles.desmondchen.com;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 127.0.0.1:14443 ssl http2 proxy_protocol;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    port_in_redirect off;

    server_name api.books-and-articles.desmondchen.com;
    ssl_certificate /etc/letsencrypt/live/books-desmondchen/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/books-desmondchen/privkey.pem;
    client_max_body_size 12m;
    location / {
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
server {
    listen 127.0.0.1:14443 ssl http2 proxy_protocol;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    port_in_redirect off;

    server_name books-and-articles.desmondchen.com;
    ssl_certificate /etc/letsencrypt/live/books-desmondchen/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/books-desmondchen/privkey.pem;
    root /var/www/books-and-articles;
    index index.html;
    location / { try_files $uri $uri/ /index.html; }
}
