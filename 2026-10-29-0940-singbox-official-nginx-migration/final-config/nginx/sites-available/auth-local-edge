# Auth edge on the VPS - served by the box's existing nginx.
# TLS: Let's Encrypt cert "signal-align-auth" (DNS-01 via Cloudflare,
# issued before the DNS cutover so the switch is zero-downtime; renewal via
# /etc/cron.d/certbot-dns -> /opt/certbot-dns/bin/certbot renew).
# Proxy targets are the compose ports published on the host loopback.

# hydra-public (4444)
server {
    listen 80;
    listen [::]:80;
    server_name auth.signal-align.com;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 127.0.0.1:14443 ssl http2 proxy_protocol;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    port_in_redirect off;

    server_name auth.signal-align.com;

    ssl_certificate /etc/letsencrypt/live/signal-align-auth/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/signal-align-auth/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:4444;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

