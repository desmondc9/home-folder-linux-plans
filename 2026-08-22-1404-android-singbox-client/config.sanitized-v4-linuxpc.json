        "outbound": "proxy"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-greatfire"
        ],
        "outbound": "proxy"
      }
    ],
    "rule_set": [
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
        "update_interval": "7d",
        "http_client": "proxy-http"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "update_interval": "7d",
        "http_client": "proxy-http"
      },
      {
        "tag": "geosite-greatfire",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-greatfire.srs",
        "update_interval": "7d",
        "http_client": "proxy-http"
      }
    ],
    "final": "proxy",
    "auto_detect_interface": true
  },
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "ts-ep",
      "state_directory": "tailscale",
      "control_url": "https://bandwagon.signal-align.com",
      "auth_key": "<HEADSCALE-PREAUTH-KEY>",
      "hostname": "desmond-linux-pc",
      "accept_routes": false
